<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="repasoS4.Views.vRepaso"
             Title="vRepaso">

    <ContentPage.Resources>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="Blue"/>
            <Setter Property="Background" Value="Beige"
                    />
        </Style>

        <Style x:Key="labelEstilo" TargetType="Label">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="TextColor" Value="Chocolate"/>
        </Style>
    </ContentPage.Resources>
    
    <VerticalStackLayout
        Spacing="20"
        Padding="20">
        <Label 
            Text="Ventana de Registro"
            VerticalOptions="Center" 
            Style="{StaticResource labelEstilo}"
            HorizontalOptions="Center" />
        <Image Source="uisrael.png"
               WidthRequest="200"/>

        <Grid RowSpacing="10"
              ColumnSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Text="Desarrollado por:"
                   Grid.Row="0"
                   Grid.Column="0"/>
            <Label Text="Carrera: "
                   Grid.Row="0"
                   Grid.Column="1"/>
            <Label Text="Nivel"
                   Grid.Row="0"
                   
                   Grid.Column="2"/>
            <Entry x:Name="txtNombre"
                   Grid.Row="1"
                   IsReadOnly="True"
                   Grid.Column="0"/>
            <Entry x:Name="txtCarrera"
                   IsReadOnly="True"
                   Grid.Row="1"
                   Grid.Column="1"/>
            <Entry x:Name="txtNivel"
                   IsEnabled="False"
                   Grid.Row="1"
                   Grid.Column="2"/>
        </Grid>

        <Grid RowSpacing="15" ColumnSpacing="10" 
              HorizontalOptions="Center"
              VerticalOptions="Center">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Label Text="USUARIO"                  
                   FontSize="18"
                   Grid.Row="0"
                   Grid.Column="0"/>
            <Entry x:Name="txtUsuario"
                   Placeholder="Ingresa el usuario"
                   Grid.Row="0"
                 
                   Grid.Column="1"/>
            <Label Text="CONTRASEÑA"                   
                   FontSize="18"
                   Grid.Row="1"
                   Grid.Column="0"/>
            <Entry x:Name="txtContrasena"
                   Placeholder="Ingrese la contraseña"
                   IsPassword="True"
                   
                   Grid.Row="1"
                   Grid.Column="1"/>

            <Button x:Name="btnIniciarSesion"
                    Text="Iniciar Sesión"                   
                    Clicked="btnIniciarSesion_Clicked"
                    Grid.Row="2"
                    Grid.Column="0"/>
            <Button x:Name="btnRegistrar"
                   Text="Registrar Usuario"                      
                    Clicked="btnRegistrar_Clicked"
                    Grid.Row="2"
                    Grid.Column="1"/>

        </Grid>



    </VerticalStackLayout>
</ContentPage>